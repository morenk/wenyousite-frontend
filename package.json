{
  "name": "wenyousite-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=3072 next dev --port 3001",
    "dev:e2e": "NODE_OPTIONS=--max-old-space-size=3072 next dev --port 3101",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:api": "pnpm --dir ../wenyousite-backend openapi:export /tmp/wenyousite-openapi.json && openapi-typescript /tmp/wenyousite-openapi.json -o src/api/types.ts",
    "contract:check": "node scripts/check-generated-api.mjs",
    "arch:check": "node scripts/check-query-keys.mjs",
    "snapshots:check": "tsx scripts/check-api-snapshots.ts",
    "snapshots:sanitize": "tsx scripts/sanitize-api-snapshots.ts",
    "snapshots:verify": "tsx scripts/api-verify.ts",
    "docs:check": "tsx scripts/check-doc-links.ts && tsx scripts/check-doc-truth.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm contract:check && pnpm arch:check && pnpm test:coverage && pnpm snapshots:check && pnpm docs:check && pnpm build",
    "check:full": "pnpm check && E2E_ENV=test pnpm test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.5.7",
    "@milkdown/core": "^7.21.3",
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/ctx": "^7.21.3",
    "@milkdown/kit": "7.21.3",
    "@milkdown/react": "^7.21.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.83.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "happy-dom": "^20.11.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
