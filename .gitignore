# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.e2e.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
test-results/
playwright-report/

# 本轮脱敏 E2E 结果（不含私有账号环境）
/.e2e-results/

# 交互预览私有会话与独立 Fast Refresh 缓存
/.next-preview/
/.dev-preview/
